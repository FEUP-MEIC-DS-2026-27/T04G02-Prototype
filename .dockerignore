storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php
public/storage
public/hot

# Environment files (the image reads real environment variables)
.env
.env.local
.env.*.backup

# Docker-related
docker-compose*.yml
docker-compose*.yaml
compose*.yaml
.dockerignore
Dockerfile

# Separate images
sse-hub
frontend

# IDE/editor files
.vscode
.idea
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db

# Misc logs
*.log

# Git
.git
.gitignore
.github

# Node/NPM artifacts
node_modules
npm-debug.log
yarn-error.log

# Composer dependencies (installed in the image)
vendor

# Laravel runtime artifacts and local caches (packages.php lists dev-only providers)

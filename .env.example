# Optional: compose.yaml has defaults for everything, so a .env file is only for overrides.

# Leave empty and the container generates a temporary key on start.
# To pin one: docker compose run --rm --no-deps project-status-api php artisan key:generate --show
APP_KEY=
APP_ENV=local
APP_DEBUG=true

DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# Origins allowed to call the API and open the SSE stream (shell, VA3, our remote)
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3005

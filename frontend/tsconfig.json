{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@rsbuild/core/types"]
  },
  "include": ["src", "*.ts"]
}
